# Local Development Environment Variables (MySQL)
# Loaded via spring.config.import=optional:file:./.env[.properties]

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8181

# JWT (required — no committed fallback)
JWT_SECRET=T5qUlVhPawknL75YpiKZ29yD0JoyotdempmMWRdPRBGRTz+2BmQFoWgUBc2taV0gYxJpRaY5lrnkFWv6aKwMng==
JWT_EXPIRATION=3600000
REFRESH_TOKEN_EXPIRATION=86400000

# MySQL local (application-dev.properties)
DB_USERNAME=root
DB_PASSWORD=root

# Tenancy — MySQL catalog switching
TENANCY_SCHEMA_SWITCHER=mysql
TENANCY_PLATFORM_SCHEMA=thinkerscave_dev

# Refresh cookie for local Angular (localhost:4300)
REFRESH_COOKIE_ENABLED=true
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

# Auth hardening (dev-friendly)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_MAX_FAILED_ATTEMPTS=5

# CORS is set in application-dev.properties for localhost:4200/4300

# Mail (optional in local)
MAIL_USERNAME=thinkerscave2025.edu@gmail.com
MAIL_PASSWORD=ymfpilxejapzpbzz
