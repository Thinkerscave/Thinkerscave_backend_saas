# =============================================================================
# OS / container environment variables (NOT loaded by Spring as a .env file)
# Set these in the host, systemd, Docker --env-file, or CI secrets.
# Copy values into your deployment environment manager — do not commit secrets.
# =============================================================================

# Profile: prod | test | dev
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL (prod/test) — omit to use profile defaults in application-*.properties
# DB_URL=jdbc:postgresql://HOST:5435/thinkerscave_db?options=-c%20TimeZone%3DUTC
# DB_USERNAME=thinkerscave
# DB_PASSWORD=
# TENANCY_SCHEMA_SWITCHER=postgresql
# TENANCY_PLATFORM_SCHEMA=public

# JWT (strongly recommended to override in real production)
# JWT_SECRET=
JWT_EXPIRATION=3600000
REFRESH_TOKEN_EXPIRATION=86400000

# CORS
ALLOWED_ORIGINS=*

# Uploads (Windows local run: use relative uploads)
UPLOAD_BASE_DIR=/var/thinkerscave/uploads

# =============================================================================
# FREE EMAIL — Gmail SMTP (required for real inbox delivery)
# Same mail path is used for: Forgot Password OTP, Customer welcome,
# Organization owner "ready" mail, and Org Admin welcome credentials.
#
# Setup (once):
# 1) Google Account → Security → 2-Step Verification → ON
# 2) App passwords → create one for "Mail" → copy 16-char password
# 3) Fill the values below (use the Gmail address as MAIL_USERNAME)
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=your.gmail@gmail.com

# =============================================================================
# FREE SMS — default is "log" (prints to backend logs, always free)
# Optional real SMS: Textbelt free key = 1 SMS per day (no signup)
#   SMS_PROVIDER=textbelt
#   SMS_API_KEY=textbelt
# For more volume you need a paid Textbelt key (not free).
# Used for: password OTP, customer welcome, org onboarding notices
# when a mobile number exists on the user/contact.
# =============================================================================
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
SMS_PROVIDER=log
SMS_API_KEY=textbelt
SMS_DEFAULT_COUNTRY_CODE=91
SMS_SENDER=ThinkersCave

# Dev helper: also print OTP in server logs (keep false in real prod)
PASSWORD_RESET_LOG_OTP=false

# JVM (also set in spring-boot-maven-plugin / systemd)
# JAVA_TOOL_OPTIONS=-Duser.timezone=UTC
