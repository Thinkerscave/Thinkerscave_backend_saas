# Profile: prod | test | dev  (all share the same deploy space for now)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL — optional overrides when test/prod DBs split later
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5435/thinkerscave_db?options=-c%20TimeZone%3DUTC
# SPRING_DATASOURCE_USERNAME=thinkerscave
# SPRING_DATASOURCE_PASSWORD=
# TENANCY_SCHEMA_SWITCHER=postgresql
# TENANCY_PLATFORM_SCHEMA=public

# JWT (strongly recommended to override in real production)
# JWT_SECRET=
JWT_EXPIRATION=3600000
REFRESH_TOKEN_EXPIRATION=86400000

# CORS
ALLOWED_ORIGINS=*

# Uploads
UPLOAD_BASE_DIR=/var/thinkerscave/uploads

# FREE EMAIL — Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=your.gmail@gmail.com

NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
SMS_PROVIDER=log
SMS_API_KEY=textbelt
SMS_DEFAULT_COUNTRY_CODE=91
SMS_SENDER=ThinkersCave

PASSWORD_RESET_LOG_OTP=false
