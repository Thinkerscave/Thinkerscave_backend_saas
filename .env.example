# ThinkersCave SaaS Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# Profile (dev for local MySQL; prod for Docker/VPS)
# ============================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8181

# ============================================
# Database (MySQL local / PostgreSQL production)
# ============================================
# Dev (MySQL) typically uses application-dev defaults + username/password:
DB_USERNAME=root
DB_PASSWORD=root
# Prod (PostgreSQL) — required when SPRING_PROFILES_ACTIVE=prod:
# DB_URL=jdbc:postgresql://host:5432/thinkerscave_saas
# DB_USERNAME=your_db_username
# DB_PASSWORD=your_db_password

# ============================================
# JWT Configuration (REQUIRED — no committed fallback)
# Generate: openssl rand -base64 64
# ============================================
JWT_SECRET=replace_with_openssl_rand_base64_64
JWT_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=86400000

# ============================================
# Refresh Token Cookie (HttpOnly)
# ============================================
REFRESH_COOKIE_ENABLED=true
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_MAX_AGE=86400

# ============================================
# Auth hardening
# ============================================
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_RETRY_DELAY_MS=500
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# Tenancy (MySQL catalog today; postgresql later)
# ============================================
TENANCY_SCHEMA_SWITCHER=mysql
TENANCY_PLATFORM_SCHEMA=thinkerscave_dev

# ============================================
# Uploads
# ============================================
UPLOAD_BASE_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# ============================================
# Email Configuration
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:4300,http://localhost:4200
