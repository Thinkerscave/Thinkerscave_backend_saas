# ThinkersCave SaaS Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# Profile
#   dev      = remote server PostgreSQL (72.61.244.175)
#   testing  = local MySQL (seed ON)
#   test     = JUnit H2
#   prod     = hardened production
# ============================================
SPRING_PROFILES_ACTIVE=testing
SERVER_PORT=8181

# ============================================
# Database
# ============================================
# testing (MySQL local):
DB_USERNAME=root
DB_PASSWORD=root
# TENANCY_SCHEMA_SWITCHER=mysql
# TENANCY_PLATFORM_SCHEMA=thinkerscave_dev

# dev (remote PostgreSQL) — defaults are also in application-dev.properties:
# SPRING_PROFILES_ACTIVE=dev
# SERVER_PORT=8080
# DB_URL=jdbc:postgresql://72.61.244.175:5435/thinkerscave_db
# DB_USERNAME=thinkerscave
# DB_PASSWORD=cP7_min30Xt17DpFYuE8
# TENANCY_SCHEMA_SWITCHER=postgresql
# TENANCY_PLATFORM_SCHEMA=public

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=replace_with_openssl_rand_base64_64
JWT_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=86400000

# ============================================
# Refresh Token Cookie (HttpOnly)
# ============================================
REFRESH_COOKIE_ENABLED=true
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_MAX_AGE=86400

# ============================================
# Auth hardening
# ============================================
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_RETRY_DELAY_MS=500
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# Tenancy
# ============================================
TENANCY_SCHEMA_SWITCHER=mysql
TENANCY_PLATFORM_SCHEMA=thinkerscave_dev

# ============================================
# Uploads
# ============================================
UPLOAD_BASE_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# ============================================
# Email Configuration
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:4300,http://localhost:4200
