# ThinkersCave SaaS Backend - Environment Variables Template
# Copy to .env for local overrides. NEVER commit .env.

# ============================================
# Profile
#   dev  = local MySQL + localhost:8181
#   test = testing server PostgreSQL :8080
#   prod = production deploy (same server for now)
# ============================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8181

# ============================================
# Database
# ============================================
# Local (dev):
DB_USERNAME=root
DB_PASSWORD=root
TENANCY_SCHEMA_SWITCHER=mysql
TENANCY_PLATFORM_SCHEMA=thinkerscave_dev

# Server (test/prod) — defaults already in application-test/prod.properties:
# SPRING_PROFILES_ACTIVE=prod
# SERVER_PORT=8080
# DB_URL=jdbc:postgresql://72.61.244.175:5435/thinkerscave_db?options=-c%20TimeZone%3DUTC
# DB_USERNAME=thinkerscave
# DB_PASSWORD=...
# TENANCY_SCHEMA_SWITCHER=postgresql
# TENANCY_PLATFORM_SCHEMA=public

# ============================================
# JWT
# ============================================
JWT_SECRET=replace_with_openssl_rand_base64_64
JWT_EXPIRATION=3600000
REFRESH_TOKEN_EXPIRATION=86400000

# ============================================
# CORS (* allowed for current shared deploy)
# ============================================
ALLOWED_ORIGINS=*

# ============================================
# Uploads / Mail (optional overrides)
# ============================================
UPLOAD_BASE_DIR=uploads
MAIL_HOST=localhost
MAIL_PORT=25
